generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id           String       @id @default(cuid())
  title        String
  dong         String
  address      String
  lat          Float
  lng          Float
  price        Int
  deposit      Int
  propertyType PropertyType
  area         Float
  floor        Int?
  totalFloors  Int?
  description  String?
  // Ingestion metadata
  source       Source       @default(MANUAL)
  externalId   String?      // set when imported from an external source
  isActive     Boolean      @default(true)
  lastSyncedAt DateTime?
  brokerId     String?
  broker       Broker?      @relation(fields: [brokerId], references: [id])
  photos       Photo[]
  reviews      Review[]
  priceHistory PriceHistory[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Price change log for a listing — enables trend detection.
model PriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Int
  deposit    Int
  recordedAt DateTime @default(now())
}

// Completed real-estate transactions from MOLIT (국토교통부).
// NOT displayed as listings — used for market price benchmarking in the trust engine.
model MarketTransaction {
  id           String       @id @default(cuid())
  source       Source
  externalId   String
  dong         String
  lat          Float?
  lng          Float?
  price        Int          // monthly rent in KRW (0 for 전세)
  deposit      Int          // deposit in KRW
  area         Float        // ㎡
  floor        Int?
  propertyType PropertyType
  dealYear     Int
  dealMonth    Int
  createdAt    DateTime     @default(now())

  @@unique([source, externalId])
}

model Review {
  id                  String   @id @default(cuid())
  listingId           String
  listing             Listing  @relation(fields: [listingId], references: [id])
  tenancyStart        DateTime
  tenancyEnd          DateTime
  noise               Int
  pests               Int
  winterCold          Int
  summerHeat          Int
  landlordResponse    Int
  overallSatisfaction Int
  pros                String
  cons                String
  createdAt           DateTime @default(now())
}

model Photo {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  url        String
  uploadedAt DateTime @default(now())
}

model Broker {
  id       String    @id @default(cuid())
  name     String
  phone    String?
  listings Listing[]
}

enum PropertyType {
  STUDIO
  ONE_ROOM
  TWO_ROOM
  OFFICE_TEL
}

enum Source {
  MANUAL
  MOLIT
}

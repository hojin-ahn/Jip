generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id           String       @id @default(cuid())
  title        String
  dong         String
  address      String
  lat          Float
  lng          Float
  price        Int
  deposit      Int
  propertyType PropertyType
  area         Float
  floor        Int?
  totalFloors  Int?
  description  String?
  brokerId     String?
  broker       Broker?      @relation(fields: [brokerId], references: [id])
  photos       Photo[]
  reviews      Review[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Review {
  id                  String   @id @default(cuid())
  listingId           String
  listing             Listing  @relation(fields: [listingId], references: [id])
  tenancyStart        DateTime
  tenancyEnd          DateTime
  noise               Int
  pests               Int
  winterCold          Int
  summerHeat          Int
  landlordResponse    Int
  overallSatisfaction Int
  pros                String
  cons                String
  createdAt           DateTime @default(now())
}

model Photo {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  url        String
  uploadedAt DateTime @default(now())
}

model Broker {
  id       String    @id @default(cuid())
  name     String
  phone    String?
  listings Listing[]
}

enum PropertyType {
  STUDIO
  ONE_ROOM
  TWO_ROOM
  OFFICE_TEL
}
